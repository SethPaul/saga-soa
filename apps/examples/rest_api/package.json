{
  "name": "rest_api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node dist/main.js\"",
    "dev:nestjs": "tsup src/main-nestjs.ts --format esm --target node16 --watch --onSuccess \"node dist/main-nestjs.js\"",
    "build": "tsup",
    "build:nestjs": "tsup src/main-nestjs.ts --format esm --target node16",
    "start": "node dist/main.js",
    "start:nestjs": "node dist/main-nestjs.js",
    "check-types": "tsc --noEmit",
    "lint": "echo 'add lint script'",
    "test": "echo 'add test script'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@saga-soa/config": "workspace:*",
    "@saga-soa/core-api": "workspace:*",
    "@saga-soa/logger": "workspace:^",
    "express": "^4.18.2",
    "figlet": "^1.8.1",
    "inversify": "^6.0.1",
    "reflect-metadata": "^0.1.14",
    "routing-controllers": "^0.11.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "tsup": "^8.5.0"
  }
}