{
  "name": "@saga/db",
  "type": "module",
  "scripts": {
    "dev": "bunchee --watch",
    "build": "bunchee",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sql": {
      "types": "./src/sql.ts",
      "default": "./dist/sql.js"
    },
    "./redis": {
      "types": "./src/redis.ts",
      "default": "./dist/redis.js"
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@saga-soa/config": "workspace:*",
    "@saga/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.3",
    "bunchee": "^6.5.4",
    "jest": "^30.0.0",
    "mongodb-memory-server": "^10.1.4",
    "ts-jest": "^29.4.0",
    "typescript": "latest"
  },
  "dependencies": {
    "inversify": "^6.0.1",
    "mongodb": "^5.7.0",
    "reflect-metadata": "^0.1.13",
    "zod": "^3.22.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "version": "1.0.0"
}